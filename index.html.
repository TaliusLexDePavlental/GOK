
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#111214">
<title>ПРОФИ | Погода и безопасность</title>
<style>
:root {
  color-scheme: dark;
  --bg:#101113;
  --panel:#1a1b1e;
  --panel2:#222428;
  --line:#34363b;
  --text:#f5f5f5;
  --muted:#a8abb1;
  --red:#e21b2b;
  --red2:#a80e1b;
  --amber:#ffbd59;
}
* { box-sizing:border-box }
body {
  margin:0;
  background:radial-gradient(ellipse at 90% -10%,#492026 0,transparent 38%),var(--bg);
  color:var(--text);
  font-family:Inter,Segoe UI,Arial,sans-serif;
  min-height:100vh;
}
main { max-width:1180px; margin:auto; padding:22px 18px 38px }
.top { display:flex; align-items:center; gap:14px; flex-wrap:wrap; padding-bottom:18px; border-bottom:1px solid var(--line) }
.logo { width:64px; height:64px; flex:0 0 64px; border:2px solid var(--red); border-radius:12px; overflow:hidden; background:#292a2d; display:grid; place-items:center; color:white; font-weight:1000; font-size:22px; cursor:pointer }
.logo img { width:100%; height:100%; object-fit:cover }
.brand { flex:1; min-width:180px }
.eyebrow { font-size:11px; text-transform:uppercase; letter-spacing:.16em; color:#ff5965; font-weight:800 }
.brand h1 { margin:5px 0 0; font-size:clamp(24px,4vw,34px); letter-spacing:-.04em }
.brand h1 span { color:var(--red) }
.sub { color:var(--muted); margin-top:5px; font-size:13px }
.status { border:1px solid var(--line); border-radius:999px; padding:9px 12px; color:var(--muted); font-size:12px }
.controls { display:flex; gap:9px; flex-wrap:wrap; margin:18px 0 }
.select,button { border:1px solid var(--line); border-radius:10px; padding:11px 13px; background:var(--panel2); color:var(--text); font:inherit }
.select { flex:1; min-width:220px }
button { cursor:pointer; font-weight:800 }
button.primary { background:var(--red); border-color:var(--red) }
button:hover { filter:brightness(1.1) }
button:disabled { opacity:.6; cursor:wait }
.hero { background:linear-gradient(125deg,#252629,#17181b 70%); border:1px solid #3c3032; border-top:3px solid var(--red); border-radius:18px; padding:24px; display:grid; grid-template-columns:1.2fr 1fr; gap:20px; align-items:center; box-shadow:0 15px 45px #0004 }
.location-label { color:#ff6b75; font-weight:800; text-transform:uppercase; letter-spacing:.1em; font-size:11px }
.weather-icon { font-size:46px; margin-top:10px }
.temp { font-size:clamp(64px,10vw,94px); font-weight:850; letter-spacing:-.08em; line-height:1 }
.condition { font-size:20px; margin-top:8px }
.feels,.date { color:var(--muted); margin-top:7px }
.hero-side { border-left:1px solid var(--line); padding-left:22px }
.hero-side h2 { margin:0 0 10px; font-size:17px }
.notice { border-left:4px solid var(--amber); padding:10px 12px; background:#3b3020; border-radius:0 8px 8px 0; font-size:13px; line-height:1.5; margin-top:12px }
.metrics { display:grid; grid-template-columns:repeat(4,1fr); gap:11px; margin-top:14px }
.metric,.section,.day { background:var(--panel); border:1px solid var(--line); border-radius:13px; padding:16px }
.metric-label { font-size:12px; color:var(--muted) }
.metric-value { font-size:22px; font-weight:800; margin-top:8px }
.section { margin-top:14px }
.section-head { display:flex; justify-content:space-between; gap:12px; align-items:center; flex-wrap:wrap }
.section h2 { font-size:18px; margin:0 0 13px }
.forecast { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:8px }
.day { text-align:center; padding:13px 7px }
.day-name { font-weight:800; font-size:12px }
.day-icon { font-size:25px; margin:11px 0 }
.day-desc { font-size:11px; color:var(--muted); min-height:29px }
.hi { font-weight:800; margin-top:8px }
.lo { color:var(--muted); margin-top:4px; font-size:12px }
.hourly { display:grid; grid-template-columns:repeat(8,minmax(70px,1fr)); gap:8px; overflow-x:auto }
.hour { background:var(--panel2); border:1px solid var(--line); border-radius:10px; text-align:center; padding:12px 7px }
.hour time { font-size:12px; color:var(--muted) }
.hour div { margin:8px 0 }
.hour b { font-size:17px }
.safety-list { display:grid; grid-template-columns:repeat(3,1fr); gap:9px }
.warning-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px }
.warning-card { border:1px solid var(--line); background:#202124; border-radius:12px; padding:14px }
.warning-card.red { border-top:3px solid var(--red) }
.warning-card.amber { border-top:3px solid var(--amber) }
.warning-card.green { border-top:3px solid #48b47a }
.warning-card h3 { font-size:14px; margin:0 0 10px }
.warning-card ul { margin:0; padding-left:18px; color:#d6d7da; font-size:12px; line-height:1.55 }
.warning-card li+li { margin-top:6px }
.risk-pill { display:inline-block; border-radius:999px; padding:4px 8px; font-size:10px; font-weight:900; text-transform:uppercase; margin-bottom:9px }
.risk-pill.red { background:#501b20; color:#ff9da4 }
.risk-pill.amber { background:#49371e; color:#ffd18a }
.risk-pill.green { background:#193a2a; color:#8be0ad }
.safety-item { background:#242426; border:1px solid var(--line); border-radius:11px; padding:13px; font-size:13px; line-height:1.45 }
.safety-item b { display:block; color:#ff6670; margin-bottom:5px }
.note { font-size:12px; color:var(--muted); line-height:1.5; margin-top:14px }
.bottom { display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; color:var(--muted); font-size:12px; margin-top:15px }
.error { color:#ffaaa9 }
.hidden { display:none!important }

@media(max-width:760px) {
  main { padding:14px 12px 28px }
  .top { gap:10px }
  .logo { width:54px; height:54px; flex-basis:54px }
  .status { width:100%; text-align:center }
  .hero { grid-template-columns:1fr; padding:19px; gap:16px }
  .hero-side { border-left:0; border-top:1px solid var(--line); padding:14px 0 0 }
  .metrics { grid-template-columns:repeat(2,minmax(0,1fr)) }
  .forecast { grid-template-columns:repeat(2,minmax(0,1fr)) }
  .day:last-child { grid-column:span 2 }
  .safety-list,.warning-grid { grid-template-columns:1fr }
  .select { min-width:100% }
  .controls button { flex:1 }
}
</style>
</head>
<body>
<main>
<header class="top">
  <label class="logo" for="logoFile" title="Нажми, чтобы добавить фото">
    <span id="logoFallback">ПФ</span>
    <img id="logoImage" class="hidden" alt="Фото рядом с названием">
  </label>
  <input id="logoFile" class="hidden" type="file" accept="image/*">
  <div class="brand">
    <div class="eyebrow">Промышленная погода · охрана труда</div>
    <h1><span>ПРОФИ</span> / Погода и безопасность</h1>
    <div class="sub">Быстринский ГОК · Газимурский район</div>
  </div>
  <div class="status" id="updated">Загрузка данных…</div>
</header>

<div class="controls">
  <select class="select" id="location">
    <option value="gok">Быстринский ГОК</option>
    <option value="gaz">Газимурский Завод / район</option>
  </select>
  <button class="primary" id="refresh">↻ Обновить погоду</button>
</div>

<section class="hero">
  <div>
    <div class="location-label" id="placeLabel">Быстринский ГОК</div>
    <div class="weather-icon" id="icon">⛅</div>
    <div class="temp" id="temp">—°</div>
    <div class="condition" id="condition">Получаем данные…</div>
    <div class="feels" id="feels">Ощущается как —</div>
    <div class="date" id="today">—</div>
  </div>
  <div class="hero-side">
    <h2>Погодная обстановка</h2>
    <div class="metric-label">Предварительная оценка условий</div>
    <div class="notice" id="alert">Ожидаем актуальные данные погоды.</div>
    <p class="note">Прогнозная модель не заменяет фактические замеры на объекте, официальные предупреждения и требования нарядов-допусков.</p>
  </div>
</section>

<section class="metrics">
  <div class="metric"><div class="metric-label">Ветер</div><div class="metric-value" id="wind">—</div></div>
  <div class="metric"><div class="metric-label">Порывы ветра</div><div class="metric-value" id="gust">—</div></div>
  <div class="metric"><div class="metric-label">Влажность</div><div class="metric-value" id="humidity">—</div></div>
  <div class="metric"><div class="metric-label">Осадки сейчас</div><div class="metric-value" id="rain">—</div></div>
</section>

<section class="section">
  <div class="section-head"><h2>Почасовой прогноз</h2><span class="note">Ближайшие часы</span></div>
  <div class="hourly" id="hourly"></div>
</section>

<section class="section">
  <h2>Прогноз на 7 дней</h2>
  <div class="forecast" id="forecast"></div>
</section>

<section class="section">
  <h2>Актуальные предупреждения по погоде</h2>
  <div class="note" style="margin:0 0 12px">Предупреждения формируются автоматически по текущему прогнозу. Это подсказки для оценки риска, а не автоматическое разрешение или запрет работ.</div>
  <div class="warning-grid" id="dynamicWarnings">
    <div class="warning-card amber">Загружаем данные для оценки рисков…</div>
  </div>
  <div class="note">Пороговые значения ниже — ориентиры для внимания. Для остановки/допуска работ применяйте требования действующих правил, ППР/ТК, паспортов техники и фактические измерения.</div>
</section>

<section class="section">
  <h2>Памятка по погодным рискам</h2>
  <div class="safety-list">
    <div class="safety-item"><b>Ветер и высота</b>Перед работами на высоте и с кранами проверь фактический ветер и ограничения в документации.</div>
    <div class="safety-item"><b>Мороз и обледенение</b>Проверь проходы, лестницы, настилы, технику и состояние СИЗ от скольжения.</div>
    <div class="safety-item"><b>Снег и видимость</b>Оцени видимость, состояние дорог, освещение и безопасные маршруты движения техники.</div>
  </div>
  <div class="note">Рекомендации информационные. Решение о допуске к работам принимается по действующим требованиям, инструкциям и фактической обстановке на месте.</div>
</section>

<div class="bottom">
  <span id="source">Источник данных: Open-Meteo</span>
  <span id="cacheNote">Кэш прогноза будет доступен после первой загрузки.</span>
</div>
<div class="note error" id="message" role="status"></div>
</main>

<script>
const $ = id => document.getElementById(id);

const places = {
  gok: {name:"Быстринский ГОК",lat:50.55,lon:117.15,tz:"Asia/Chita"},
  gaz: {name:"Газимурский Завод / район",lat:51.37,lon:118.33,tz:"Asia/Chita"}
};

const descriptions = {
  0:"Ясно",1:"Преимущественно ясно",2:"Переменная облачность",3:"Пасмурно",
  45:"Туман",48:"Изморозь и туман",51:"Слабая морось",53:"Морось",
  55:"Сильная морось",56:"Ледяная морось",57:"Сильная ледяная морось",
  61:"Небольшой дождь",63:"Дождь",65:"Сильный дождь",66:"Ледяной дождь",
  67:"Сильный ледяной дождь",71:"Небольшой снег",73:"Снег",75:"Сильный снег",
  77:"Снежная крупа",80:"Кратковременный дождь",81:"Ливень",82:"Сильный ливень",
  85:"Снегопад",86:"Сильный снегопад",95:"Гроза",96:"Гроза с градом",99:"Сильная гроза с градом"
};

function ico(c,night=false) {
  if(c===0) return night?"🌙":"☀️";
  if([1,2].includes(c)) return night?"☁️":"⛅";
  if(c===3) return "☁️";
  if([45,48].includes(c)) return "🌫️";
  if([51,53,55,56,57,61,63,65,66,67,80,81,82].includes(c)) return "🌧️";
  if([71,73,75,77,85,86].includes(c)) return "❄️";
  if([95,96,99].includes(c)) return "⛈️";
  return "🌡️";
}

const fmtDate = s => new Date(s+"T12:00:00").toLocaleDateString("ru-RU", {
  weekday:"short",day:"numeric",month:"short"
});

function setCached(loc,data) {
  try { localStorage.setItem("profi_weather_"+loc,JSON.stringify({savedAt:Date.now(),data})); } catch(e) {}
}

function showCached(loc) {
  try {
    const saved=JSON.parse(localStorage.getItem("profi_weather_"+loc)||"null");
    if(!saved) return false;
    renderWeather(saved.data,loc,true,saved.savedAt);
    return true;
  } catch(e) { return false; }
}

function renderWeather(d,loc,offline=false,savedAt=null) {
  const p=places[loc],c=d.current,day=d.daily;
  $("placeLabel").textContent=p.name;
  $("icon").textContent=ico(c.weather_code,!c.is_day);
  $("temp").textContent=Math.round(c.temperature_2m)+"°";
  $("condition").textContent=descriptions[c.weather_code]||"Погодные условия";
  $("feels").textContent=`Ощущается как ${Math.round(c.apparent_temperature)}°`;
  $("today").textContent=new Date(c.time).toLocaleString("ru-RU",{
    weekday:"long",day:"numeric",month:"long",hour:"2-digit",minute:"2-digit",timeZone:p.tz
  });

  $("wind").textContent=Math.round(c.wind_speed_10m)+" км/ч";
  $("gust").textContent=Math.round(c.wind_gusts_10m)+" км/ч";
  $("humidity").textContent=c.relative_humidity_2m+"%";
  $("rain").textContent=(c.precipitation??0)+" мм";

  let alerts=[];
  if(c.wind_speed_10m>=36) alerts.push("Сильный ветер: проверь ограничения для работ и техники.");
  if(c.temperature_2m<=-20) alerts.push("Сильный мороз: проверь меры защиты от холода.");
  if([65,67,75,82,86,95,96,99].includes(c.weather_code)) alerts.push("Неблагоприятные погодные явления: оцени фактическую обстановку.");
  if(c.weather_code===48||c.weather_code===66) alerts.push("Возможны обледенение и скользкие поверхности.");
  $("alert").textContent=alerts.length?alerts.join(" "):
    "Автоматические пороговые предупреждения не сработали. Перед работой всё равно проверь условия на площадке.";

  $("hourly").innerHTML=d.hourly.time.map((t,i)=>({t,i}))
    .filter(x=>x.t>=c.time).slice(0,8).map(x=>`
      <div class="hour">
        <time>${new Date(x.t).toLocaleTimeString("ru-RU",{hour:"2-digit",minute:"2-digit",timeZone:p.tz})}</time>
        <div>${ico(d.hourly.weather_code[x.i])}</div>
        <b>${Math.round(d.hourly.temperature_2m[x.i])}°</b>
        <div class="lo">Ветер ${Math.round(d.hourly.wind_speed_10m[x.i])}</div>
      </div>`).join("");

  $("forecast").innerHTML=day.time.map((date,i)=>`
    <article class="day">
      <div class="day-name">${i===0?"Сегодня":fmtDate(date)}</div>
      <div class="day-icon">${ico(day.weather_code[i])}</div>
      <div class="day-desc">${descriptions[day.weather_code[i]]||"Переменная погода"}</div>
      <div class="hi">${Math.round(day.temperature_2m_max[i])}°</div>
      <div class="lo">${Math.round(day.temperature_2m_min[i])}°</div>
      <div class="lo">Осадки ${day.precipitation_probability_max[i]??0}%</div>
    </article>`).join("");

  const wind=Number(c.wind_speed_10m)||0;
  const gust=Number(c.wind_gusts_10m)||0;
  const temp=Number(c.temperature_2m)||0;
  const apparent=Number(c.apparent_temperature)||temp;
  const precip=Number(c.precipitation)||0;
  const code=Number(c.weather_code);

  const snowCodes=[71,73,75,77,85,86];
  const rainCodes=[56,57,66,67];
  const stormCodes=[95,96,99];
  const fogCodes=[45,48];
  const badPrecip=snowCodes.includes(code)||rainCodes.includes(code)||
    stormCodes.includes(code)||fogCodes.includes(code)||precip>=1;

  const worker=[],equipment=[],general=[];

  if(wind>=12) worker.push("Ветер от 12 м/с: не начинать/приостановить работы на высоте при условиях, указанных правилами; проверить фактическую скорость ветра и ППР.");
  else if(wind>=8) worker.push("Усиление ветра: проверить устойчивость настилов, ограждений, лёгких материалов и условия работ на высоте.");

  if(temp<=-25||apparent<=-30) worker.push("Сильный холод по модели: оценить продолжительность пребывания на улице, обогрев, перерывы и состояние работников.");
  else if(temp<=-15||apparent<=-20) worker.push("Мороз/низкая ощущаемая температура: проверить тёплую спецодежду, перчатки, режим обогрева и признаки переохлаждения.");

  if(snowCodes.includes(code)||rainCodes.includes(code)||precip>=0.5) worker.push("Осадки: проверить сцепление обуви, лестниц и настилов; очистить проходы и обеспечить противоскользящие меры.");
  if(fogCodes.includes(code)) worker.push("Туман/изморозь: проверить видимость, освещение, ограждения и безопасные маршруты.");
  if(stormCodes.includes(code)) worker.push("Гроза по прогнозу: следовать плану действий объекта, оценить необходимость прекращения наружных и высотных работ.");
  if(!worker.length) worker.push("По доступным параметрам нет сработавших погодных порогов. Перед сменой всё равно осмотреть проходы, настилы, СИЗ и фактические условия.");

  if(gust>=15||wind>=12) equipment.push("Порывы/ветер повышены: проверить паспортные ограничения техники и навесного оборудования. Для крана ориентироваться на паспорт и руководство конкретной модели.");
  else if(gust>=10||wind>=8) equipment.push("Ветер усиливается: осторожность при движении порожней техники, работе с ковшом/стрелой и перемещении крупногабаритных грузов.");

  if(snowCodes.includes(code)||rainCodes.includes(code)||precip>=0.5) equipment.push("Осадки/возможный лёд: проверить тормоза, шины/гусеницы, стеклоочистители, освещение, обзор и состояние технологических дорог.");
  if(fogCodes.includes(code)||stormCodes.includes(code)) equipment.push("Плохая видимость или гроза: оценить возможность безопасного движения, работу сигнальщиков и связь; при угрозе остановить операцию по установленному порядку.");
  if(temp<=-20) equipment.push("Низкая температура: выполнять предсменный осмотр, проверить запуск, аккумуляторы, гидравлику, масла и зимние жидкости согласно инструкции производителя.");
  if(!equipment.length) equipment.push("Погодные пороги не сработали. Перед выездом проверить машину, тормоза, обзор, сигнализацию и дорожные условия.");

  if(wind>=12) general.push("Высокий ветер: проверить предупреждения для высотных работ, подъёмных операций, ограждений и складированных материалов.");
  if(temp<=-15||snowCodes.includes(code)||rainCodes.includes(code)) general.push("Вероятны скользкие поверхности/холод: организовать уборку снега и наледи, обработку проходов и осмотр рабочих зон.");
  if(fogCodes.includes(code)||stormCodes.includes(code)||precip>=1) general.push("Погодное ухудшение: сообщить руководителям работ, оценить видимость, маршруты, освещение и необходимость изменения плана работ.");
  general.push("Руководителю смены: сопоставить прогноз с фактическими замерами на объекте и локальными инструкциями; обновить оценку рисков перед началом работ.");

  const level=(wind>=12||gust>=15||stormCodes.includes(code)||temp<=-25||apparent<=-30)?"red":
    (wind>=8||gust>=10||badPrecip||temp<=-15||apparent<=-20)?"amber":"green";
  const levelText={
    red:"Повышенное внимание",
    amber:"Есть погодные факторы",
    green:"Пороговые сигналы не сработали"
  }[level];

  const makeCard=(title,items,cls)=>`
    <article class="warning-card ${cls}">
      <span class="risk-pill ${cls}">${levelText}</span>
      <h3>${title}</h3>
      <ul>${items.map(x=>`<li>${x}</li>`).join("")}</ul>
    </article>`;

  $("dynamicWarnings").innerHTML=
    makeCard("Для людей",worker,level)+
    makeCard("Для техники",equipment,level)+
    makeCard("Для объекта в целом",general,level);

  $("updated").textContent=offline?"Офлайн · сохранённые данные":
    "Обновлено: "+new Date().toLocaleTimeString("ru-RU",{hour:"2-digit",minute:"2-digit",timeZone:p.tz});
  $("cacheNote").textContent=offline&&savedAt?
    "Последний прогноз: "+new Date(savedAt).toLocaleString("ru-RU"):
    "Последний успешный прогноз сохраняется на устройстве";
  $("source").textContent="Источник: Open-Meteo · ориентировочный прогноз для выбранной точки";
}

async function loadWeather() {
  const loc=$("location").value,p=places[loc],btn=$("refresh"),msg=$("message");
  btn.disabled=true;
  btn.textContent="Загрузка…";
  msg.textContent="";
  try {
    const url=`https://api.open-meteo.com/v1/forecast?latitude=${p.lat}&longitude=${p.lon}&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,weather_code,wind_speed_10m,wind_gusts_10m&hourly=temperature_2m,weather_code,wind_speed_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=${encodeURIComponent(p.tz)}&forecast_days=7`;
    const r=await fetch(url);
    if(!r.ok) throw new Error("Погодный сервис недоступен");
    const d=await r.json();
    setCached(loc,d);
    renderWeather(d,loc);
  } catch(e) {
    if(!showCached(loc)) {
      msg.textContent="Нет соединения и сохранённого прогноза. Подключись к интернету и попробуй снова.";
    } else {
      msg.textContent="Нет интернета. Показан ранее сохранённый прогноз — он может быть устаревшим.";
    }
  } finally {
    btn.disabled=false;
    btn.textContent="↻ Обновить погоду";
  }
}

$("refresh").addEventListener("click",loadWeather);
$("location").addEventListener("change",loadWeather);

$("logoFile").addEventListener("change",e=>{
  const file=e.target.files[0];
  if(!file) return;
  if(file.size>5*1024*1024) {
    alert("Выбери изображение меньше 5 МБ.");
    return;
  }
  const reader=new FileReader();
  reader.onload=()=>{
    $("logoImage").src=reader.result;
    $("logoImage").classList.remove("hidden");
    $("logoFallback").classList.add("hidden");
    try {
      localStorage.setItem("profi_weather_logo",reader.result);
    } catch(err) {
      alert("Фото слишком большое для локального сохранения. Попробуй уменьшить изображение.");
    }
  };
  reader.readAsDataURL(file);
});

try {
  const savedLogo=localStorage.getItem("profi_weather_logo");
  if(savedLogo) {
    $("logoImage").src=savedLogo;
    $("logoImage").classList.remove("hidden");
    $("logoFallback").classList.add("hidden");
  }
} catch(e) {}

loadWeather();
</script>
